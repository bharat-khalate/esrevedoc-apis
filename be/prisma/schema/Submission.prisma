enum SUBMISSION_RESULT {
    PASSED @map("passed")
    FAILED @map("failed")
}

model Submission {
    id              Int               @id @default(autoincrement())
    problem         Problem           @relation("problemSubmission", fields: [problemId], references: [id])
    problemId       Int               @map("problem_id")
    submittedByUser User              @relation("submissionUser", fields: [submittedBy], references: [id])
    submittedBy     Int               @map("submitted_by")
    code            String?           @db.Text
    result          SUBMISSION_RESULT
    tcPassed        Int               @default(0) @map("tc_passed")
    totalTc         Int               @default(0) @map("total_tc")
    createdAt       DateTime          @default(now()) @map("created_at")
    notes           Note[]            @relation("submissionNote")

    @@map("submissions")
}
